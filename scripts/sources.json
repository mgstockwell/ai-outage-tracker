  "gdelt": {
    "enabled": true,
    "_doc": "GDELT DOC 2.0 API (free, no key): https://blog.gdeltproject.org/gdelt-doc-2-0-api-debuts/ . Max 1 request per ~5 seconds.",
    "endpoint": "https://api.gdeltproject.org/api/v2/doc/doc",
    "max_records": 250,
    "pause_seconds": 6,
    "queries": [
      "downdetector (outage OR down) sourcelang:english",
      "outage (bank OR banking OR Zelle) sourcelang:english",
      "outage (PayPal OR Venmo OR \"Cash App\" OR eBay OR Square) sourcelang:english",
      "outage (Verizon OR \"AT&T\" OR \"T-Mobile\" OR Xfinity OR Spectrum OR Starlink) sourcelang:english",
      "outage (AWS OR Azure OR Cloudflare OR \"Google Cloud\" OR \"Microsoft 365\") sourcelang:english",
      "outage (ChatGPT OR OpenAI OR Claude OR Gemini OR Copilot) sourcelang:english"
    ]
  },

  "google_news": {
    "enabled": true,
    "_doc": "Google News RSS search. Set enabled to false if you prefer to rely on GDELT only.",
    "endpoint": "https://news.google.com/rss/search",
    "pause_seconds": 2,
    "queries": [
      "downdetector outage",
      "bank app outage",
      "Zelle outage",
      "PayPal outage",
      "Verizon outage",
      "AT&T outage",
      "T-Mobile outage",
      "AWS outage",
      "Cloudflare outage",
      "Microsoft 365 outage",
      "ChatGPT outage"
    ]
  },

