{
  "_comment": "Config for scripts/gather_sources.py. Edit freely: add services, aliases, queries or status feeds. Any source that fails is logged and skipped.",
  "lookback_days": 7,
  "user_agent": "ai-outage-tracker/1.0 (+https://github.com/mgstockwell/ai-outage-tracker)",
